{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/checklogin.php",
      "dest": "/api/checklogin.php"
    },
    {
      "src": "/mainpage.php",
      "dest": "/api/mainpage.php"
    },
    {
      "src": "/L-accounts.php",
      "dest": "/api/L-accounts.php"
    },
    {
      "src": "/L-attendance.php",
      "dest": "/api/L-attendance.php"
    },
    {
      "src": "/L-course.php",
      "dest": "/api/L-course.php"
    },
    {
      "src": "/L-Employees.php",
      "dest": "/api/L-Employees.php"
    },
    {
      "src": "/L-enquiry.php",
      "dest": "/api/L-enquiry.php"
    },
    {
      "src": "/L-event.php",
      "dest": "/api/L-event.php"
    },
    {
      "src": "/L-finance.php",
      "dest": "/api/L-finance.php"
    },
    {
      "src": "//L-interview.php",
      "dest": "/api/L-interview.php"
    },
    {
      "src": "/L-students.php",
      "dest": "/api/L-students.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}

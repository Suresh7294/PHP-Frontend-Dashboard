{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/checklogin.php",
      "dest": "/api/checklogin.php"
    },
    {
  "src": "/(.*\\.php)",
  "dest": "/api/$1"
}
  ]
}

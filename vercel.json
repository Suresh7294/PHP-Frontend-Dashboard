{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/checklogin.php",
      "dest": "/api/checklogin.php"
    },
    {
      "src": "/mainpage.php",
      "dest": "/api/mainpage.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/L-accounts.php",
      "dest": "/api/L-accounts.php"
      }
  ]
}
